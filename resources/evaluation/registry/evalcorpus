INFOHREF "https://github.com/Niklas-Deworetzki/cqp-tree/tree/main/resources/evaluation"
TAGSETDOC "https://universaldependencies.org/u/pos/index.html"

FULLREF "doc.id"

ATTRIBUTE   id

ATTRIBUTE   word

ATTRIBUTE   lemma

ATTRIBUTE   upos

ATTRIBUTE   xpos

ATTRIBUTE   feats

ATTRIBUTE   head

ATTRIBUTE   deprel

ATTRIBUTE   deps

ATTRIBUTE   misc


