MAINTAINER "https://github.com/Niklas-Deworetzki/cqp-tree"
INFO "evalcorpus"
NAME "CQP-Tree Evaluation Corpus"
PATH evalcorpus
ENCODING "UTF-8"
LANGUAGE "Swedish"

PATH   '/corpora/evalcorpus/indexed/'
